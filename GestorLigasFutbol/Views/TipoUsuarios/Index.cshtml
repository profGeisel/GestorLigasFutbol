@{
	ViewData["Title"] = "Inicio Usuarios";
}

<div class="container-fluid">
	<h2>Registros de Tipos de Usuarios</h2>
	<a type="button" asp-controller="" asp-action="Registrar" class="btn btn btn-outline-primary "> Agregar nuevo registro</a>
</div>
<table class="table">
	<thead>
		<tr>
			<th>Id TipoUsuario</th>
			<th>Nombre</th>
		</tr>
	</thead>
	<tbody>
		@*programando recorrido de la lista *@
		@{
			if (ViewBag.TipoUsuarios != null)
			{
				foreach (var item in ViewBag.TipoUsuarios)
				{
					//generando las filas por cada registro
					<tr>
						<td>@item.Id</td>
						<td>@item.Nombre</td>
						
						<td>
							<a asp-action="Editar" class="btn btn-outline-warning btn-sm" asp-route-id="@item.Id">Editar</a>
							<a asp-action="Ver" class="btn btn-outline-primary btn-sm" asp-route-id="@item.Id">Ver</a>
							<a asp-action="Eliminar" class="btn btn-outline-danger btn-sm" asp-route-id="@item.Id">Eliminar</a>
						</td>

					</tr>
				}
			}
		}
	</tbody>
</table>


