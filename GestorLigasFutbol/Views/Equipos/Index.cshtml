@{
	ViewData["Title"] = "Equipos";
}

<div class="container-fluid">
	<h2>Registros de Equipos</h2>
	<a type="button" asp-controller="Equipos" asp-action="Registrar" class="btn btn btn-outline-primary "> Agregar nuevo registro</a>
</div>
<table class="table">
	<thead>
		<tr>
			<th>Id</th>
			<th>Nombre</th>
			<th>Logo</th>
			<th>Correo</th>
			<th>Lugar</th>
			<th>Capitan</th>
			<th>Fundacion</th>
			<th>Descripcion</th>
			<th>Identificacion</th>
			<th>Campeonato</th>
		</tr>
	</thead>
	<tbody>
		@*programando recorrido de la lista *@
		@{
			if (ViewBag.Equipos != null)
			{
				foreach (var item in ViewBag.Equipos)
				{
					//generando las filas por cada registro
					<tr>
						<td>@item.Id</td>
						<td>@item.Nombre</td>
						<td>@item.Logo</td>
						<td>@item.CorreoE</td>
						<td>@item.Lugar</td>
						<td>@item.Capitan</td>
						<td>@item.FechaFundacion</td>
						<td>@item.Descripcion</td>
						<td>@item.NumeroIdentificacion</td>
						<td>@item.IdCampeonato</td>
						<td>
							<a asp-action="Editar" class="btn btn-outline-warning btn-sm" asp-route-id="@item.Id">Editar</a>
							<a asp-action="Ver" class="btn btn-outline-primary btn-sm" asp-route-id="@item.Id">Ver</a>
							<a asp-action="Eliminar" class="btn btn-outline-danger btn-sm" asp-route-id="@item.Id">Eliminar</a>
						</td>

					</tr>
				}
			}
		}
	</tbody>
</table>
