
<link href="//netdna.bootstrapcdn.com/bootstrap/3.1.0/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">
<script src="//netdna.bootstrapcdn.com/bootstrap/3.1.0/js/bootstrap.min.js"></script>
<script src="//code.jquery.com/jquery-1.11.1.min.js"></script>
@model ResultadosIndividuales //referenccia al modelo resultadosIndividuales
@{
	ViewData["Title"] = "Eliminando Resultados Individuales"; //titulo de la pagina
}

<div class="container">
	<div id="registroUs" style="margin-top:50px; margin-bottom:50px;" class=" mainbox col-md-6 col-md-offset-3 col-sm-8 col-sm-offset-2">
		<div class="panel panel-info">
			<h2 class="text-center">Eliminando Resultados individuales</h2>
			<div style="padding-top:30px" class="panel-body">
				<form asp-action="Eliminar" method="post" class="form-floating">
					<div class="form-group">
						<label asp-for="Id"></label>
						<input class="form-control" asp-for="Id" readonly />
					</div>
					<div class="form-group">
						<label asp-for="IdJugador"></label>
						<input class="form-control" asp-for="IdJugador" readonly />
					</div>
					<div class="form-group">
						<label asp-for="Fecha">Numero de Goles</label>
						<input class="form-control" asp-for=Fecha />
						<span asp-validation-for="Fecha" class="text-danger"></span>
					</div>
					<div class="form-group">
						<label asp-for="cantidadGoles">Numero de Goles</label>
						<input class="form-control" asp-for=cantidadGoles />
						<span asp-validation-for="cantidadGoles" class="text-danger"></span>
					</div>
					<div class="form-group">
						<label asp-for="asistencias">Asistencias</label>
						<input class="form-control" asp-for=asistencias />
						<span asp-validation-for="asistencias" class="text-danger"></span>
					</div>
					<div class="form-group">
						<label asp-for="tRojas">Tarjetas Rojas</label>
						<input class="form-control" asp-for=tRojas />
						<span asp-validation-for="tRojas" class="text-danger"></span>
					</div>
					<div class="form-group">
						<label asp-for="tAmarillas">Tarjetas Amarillas</label>
						<input class="form-control" asp-for=tAmarillas />
						<span asp-validation-for="tAmarillas" class="text-danger"></span>
					</div>
					<br />
					<div class="text-center col-sm-12 controls panel-body">
						<button type="submit" value="Eliminar" class="btn btn-sm btn-warning">Eliminar</button>
						<a asp-action="Index" class="btn btn-sm btn-secondary">Regresar a la lista</a>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}