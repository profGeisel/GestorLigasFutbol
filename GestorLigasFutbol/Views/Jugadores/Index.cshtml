@{
	ViewData["Title"] = "Jugadores";
}

<div class="container-fluid">
	<h2>Registros de Jugadores</h2>
	<a type="button" asp-controller="Jugadores" asp-action="Registrar" class="btn btn btn-outline-primary "> Agregar nuevo registro</a>
</div>
<table class="table">
	<thead>
		<tr>
			<th>Id</th>
			<th>Nombre</th>
			<th>Apellido P</th>
			<th>Apellido M</th>
			<th>Foto</th>
			<th># Camisa</th>
			<th>A_Nacimiento</th>
			<th>Edad</th>
			<th>Cedula</th>
			<th>IdEquipo</th>
		</tr>
	</thead>
	<tbody>
		@*programando recorrido de la lista *@
		@{
			if (ViewBag.Jugadores != null)
			{
				foreach (var item in ViewBag.Jugadores)
				{
					//generando las filas por cada registro
					<tr>
						<td>@item.Id</td>
						<td>@item.Nombre</td>
						<td>@item.ApellidoP</td>
						<td>@item.ApellidoM</td>
						<td>@item.Foto</td>
						<td>@item.NumeroCamisa</td>
						<td>@item.A_Nacimiento</td>
						<td>@item.Edad</td>
						<td>@item.Cedula</td>
						<td>@item.IdEquipo</td>
						<td>
							<a asp-action="Editar" class="btn btn-outline-warning btn-sm" asp-route-id="@item.Id">Editar</a>
							<a asp-action="Ver" class="btn btn-outline-primary btn-sm" asp-route-id="@item.Id">Ver</a>
							<a asp-action="Eliminar" class="btn btn-outline-danger btn-sm" asp-route-id="@item.Id">Eliminar</a>
						</td>

					</tr>
				}
			}
		}
	</tbody>
</table>

