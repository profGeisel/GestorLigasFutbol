@model List<Usuarios>

@{
	ViewData["Title"] = "Inicio Usuarios";
}
<div class="container-fluid">
	<h2>Usuarios</h2>
	<a type="button" asp-controller="Usuarios" asp-action="Insertar" class="btn btn btn-outline-primary "> Agregar nuevo registro</a>
</div>
@if (Model.Count==0)
{
	<p>No hay usuarios registrados</p>
}
else
{
	<table class="table">
	<thead>
		<tr>
			<th>Nombre</th>
			<th>ApellidoP</th>
			<th>ApellidoM</th>
			<th>CorreoE</th>
			<th>Contrasena</th>
			<th>IdTipoUsuario</th>
			<th>Opciones</th>
		</tr>
	</thead>
	<tbody>
		
		@foreach (var item in Model)
		{
		//generando las filas por cada registro
			<tr>
				<td>@Html.DisplayFor(modelsItem=>item.Nombre)</td>
				<td>@Html.DisplayFor(modelsItem=>item.ApellidoP)</td>
				<td>@Html.DisplayFor(modelsItem=>item.ApellidoM)</td>
				<td>@Html.DisplayFor(modelsItem=>item.CorreoE)</td>
				<td>@Html.DisplayFor(modelsItem=>item.Contrasena)</td>
				<td>@Html.DisplayFor(modelsItem=>item.IdTipoUsuarios)</td>
				<td>
					<a asp-action="Actualizar" class="btn btn-outline-warning btn-sm" asp-route-id="@item.Id">Editar</a>
					<a asp-action="Ver" class="btn btn-outline-primary btn-sm" asp-route-id="@item.Id">Ver</a>
					<a asp-action="Eliminar" class="btn btn-outline-danger btn-sm" asp-route-id="@item.Id">Eliminar</a>
				</td>

			</tr>
		}	
	</tbody>
</table>

}