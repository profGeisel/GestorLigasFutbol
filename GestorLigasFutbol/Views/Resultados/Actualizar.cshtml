
<link href="//netdna.bootstrapcdn.com/bootstrap/3.1.0/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">
<script src="//netdna.bootstrapcdn.com/bootstrap/3.1.0/js/bootstrap.min.js"></script>
<script src="//code.jquery.com/jquery-1.11.1.min.js"></script>
@model Resultados //referenccia al modelo resultados
@{
	ViewData["Title"] = "Actualizar Resultados"; //titulo de la pagina
}

<div class="container">
	<div id="registroUs" style="margin-top:50px; margin-bottom:50px;" class=" mainbox col-md-6 col-md-offset-3 col-sm-8 col-sm-offset-2">
		<div class="panel panel-info">
			<h2 class="text-center">Actualizar Resultados</h2>
			<div style="padding-top:30px" class="panel-body">
				<form asp-action="Actualizar" method="post" class="form-floating">
					<div class="form-group">
						<label asp-for="Id"></label>
						<input class="form-control" asp-for=Id readonly/>
					</div>
					<div class="form-group">
						<label asp-for="IdEquipo"></label>
						<input class="form-control" asp-for=IdEquipo />
						<span asp-validation-for="IdEquipo" class="text-danger"></span>
					</div>
					<div class="form-group">
						<label asp-for="IdEvento"></label>
						<input class="form-control" asp-for=IdEvento />
						<span asp-validation-for="IdEvento" class="text-danger"></span>
					</div>
					<div class="form-group">
						<label asp-for="Triunfos"></label>
						<input class="form-control" asp-for=Triunfos />
						<span asp-validation-for="Triunfos" class="text-danger"></span>
					</div>
					<div class="form-group">
						<label asp-for="Empates"></label>
						<input class="form-control" asp-for=Empates />
						<span asp-validation-for="Empates" class="text-danger"></span>
					</div>
					<div class="form-group">
						<label asp-for="Derrotas"></label>
						<input class="form-control" asp-for=Derrotas />
						<span asp-validation-for="Derrotas" class="text-danger"></span>
					</div>
					<div class="form-group">
						<label asp-for="Juegos"></label>
						<input class="form-control" asp-for=Juegos />
						<span asp-validation-for="Juegos" class="text-danger"></span>
					</div>
					<div class="form-group">
						<label asp-for="GolesFavor"></label>
						<input class="form-control" asp-for=GolesFavor />
						<span asp-validation-for="GolesFavor" class="text-danger"></span>
					</div>
					<div class="form-group">
						<label asp-for="GolesContra"></label>
						<input class="form-control" asp-for=GolesContra />
						<span asp-validation-for="GolesContra" class="text-danger"></span>
					</div>
					<div class="form-group">
						<label asp-for="DiferenciaGoles"></label>
						<input class="form-control" asp-for=DiferenciaGoles />
						<span asp-validation-for="DiferenciaGoles" class="text-danger"></span>
					</div>


					<br />
					<div class="text-center col-sm-12 controls panel-body">
						<button type="submit" value="Actualizar" class="btn btn-sm btn-warning">Actualizar</button>
						<a asp-action="Index" class="btn btn-sm btn-secondary">Regresar a la lista</a>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}