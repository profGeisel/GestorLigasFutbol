
<link href="//netdna.bootstrapcdn.com/bootstrap/3.1.0/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">
<script src="//netdna.bootstrapcdn.com/bootstrap/3.1.0/js/bootstrap.min.js"></script>
<script src="//code.jquery.com/jquery-1.11.1.min.js"></script>
@model Eventos //referenccia al modelo usuario
@{
	ViewData["Title"] = "Registro de Eventos"; //titulo de la pagina
}

<div class="container">
	<div id="registroUs" style="margin-top:50px; margin-bottom:50px;" class=" mainbox col-md-6 col-md-offset-3 col-sm-8 col-sm-offset-2">
		<div class="panel panel-info">
			<h2 class="text-center">Eliminando de Eventos</h2>
			<div style="padding-top:30px" class="panel-body">
				<form asp-action="Eliminar" method="post" class="form-floating">
					<div class="form-group">
						<label asp-for="Id"></label>
						<input class="form-control" asp-for=Id readonly />
						<span asp-validation-for="Id" class="text-danger"></span>
					</div>
					<div class="form-group">
						<label asp-for="Nombre"></label>
						<input class="form-control" asp-for=Nombre readonly />
						<span asp-validation-for="Nombre" class="text-danger"></span>
					</div>
					<div class="form-group">
						<label asp-for="Fecha"></label>
						<input class="form-control" asp-for=Fecha readonly />
						<span asp-validation-for="Fecha" class="text-danger"></span>
					</div>
					<div class="form-group">
						<label asp-for="Hora"></label>
						<input class="form-control" asp-for=Hora readonly />
						<span asp-validation-for="Hora" class="text-danger"></span>
					</div>
					<div class="form-group">
						<label asp-for="EquipoVisitante"></label>
						<input class="form-control" asp-for=EquipoVisitante readonly />
						<span asp-validation-for="EquipoVisitante" class="text-danger"></span>
					</div>
					<div class="form-group">
						<label asp-for="EquipoResidente"></label>
						<input class="form-control" asp-for=EquipoResidente readonly />
						<span asp-validation-for="EquipoResidente" class="text-danger"></span>
					</div>
					<div class="form-group">
						<label asp-for="IdCampeonato"></label>
						<input class="form-control" asp-for=IdCampeonato readonly />
						<span asp-validation-for="IdCampeonato" class="text-danger"></span>
					</div>
					<br />
					<div class="text-center col-sm-12 controls panel-body">
						<button type="submit" value="Eliminar" class="btn btn-sm btn-warning">Eliminar</button>
						<a asp-action="Index" class="btn btn-sm btn-secondary">Regresar a la lista</a>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}