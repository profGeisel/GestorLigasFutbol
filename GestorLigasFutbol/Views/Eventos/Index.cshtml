@model List<Eventos>
@{
	ViewData["Title"] = "Eventos";
}

<div class="container-fluid">
	<h2>Registros de Eventos</h2>
	<a type="button" asp-controller="Eventos" asp-action="Insertar" class="btn btn btn-outline-primary "> Agregar nuevo registro</a>
</div>
@if (Model.Count==0)
{
	<p>No hay Eventos registrados</p>
}
else
{
<table class="table">
	<thead>
		<tr>
			<th>Nombre</th>
			<th>Fecha</th>
			<th>Hora</th>
			<th>Equipo Visitante</th>
			<th>Equipo Residente</th>
			<th>Campeonato</th>
		</tr>
	</thead>
	<tbody>
			@foreach (var item in Model)
			{
					//generando las filas por cada registro
					<tr>
					<td>@Html.DisplayFor(modelsItem => item.Nombre)</td>
					<td>@Html.DisplayFor(modelsItem => item.Fecha)</td>
					<td>@Html.DisplayFor(modelsItem => item.Hora)</td>
					<td>@Html.DisplayFor(modelsItem => item.EquipoVisitante)</td>
					<td>@Html.DisplayFor(modelsItem => item.EquipoResidente)</td>
					<td>@Html.DisplayFor(modelsItem => item.IdCampeonato)</td>
					<td>
						<a asp-action="Editar" class="btn btn-outline-warning btn-sm" asp-route-id="@item.Id">Editar</a>
						<a asp-action="Ver" class="btn btn-outline-primary btn-sm" asp-route-id="@item.Id">Ver</a>
						<a asp-action="Eliminar" class="btn btn-outline-danger btn-sm" asp-route-id="@item.Id">Eliminar</a>
					</td>

					</tr>
				}
			
	</tbody>
</table>
}