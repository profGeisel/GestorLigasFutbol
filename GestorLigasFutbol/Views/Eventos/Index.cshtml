@{
	ViewData["Title"] = "Eventos";
}

<div class="container-fluid">
	<h2>Registros de Eventos</h2>
	<a type="button" asp-controller="Eventos" asp-action="Registrar" class="btn btn btn-outline-primary "> Agregar nuevo registro</a>
</div>
<table class="table">
	<thead>
		<tr>
			<th>Id</th>
			<th>Nombre</th>
			<th>Fecha</th>
			<th>Hora</th>
			<th>Equipo Visitante</th>
			<th>Equipo Residente</th>
			<th>Campeonato</th>
		</tr>
	</thead>
	<tbody>
		@*programando recorrido de la lista *@
		@{
			if (ViewBag.Equipos != null)
			{
				foreach (var item in ViewBag.Equipos)
				{
					//generando las filas por cada registro
					<tr>
						<td>@item.Id</td>
						<td>@item.Nombre</td>
						<td>@item.Fecha</td>
						<td>@item.Hora</td>
						<td>@item.EquipoVisitante</td>
						<td>@item.EquipoResidente</td>
						<td>@item.IdCampeonato</td>
						<td>
							<a asp-action="Editar" class="btn btn-outline-warning btn-sm" asp-route-id="@item.Id">Editar</a>
							<a asp-action="Ver" class="btn btn-outline-primary btn-sm" asp-route-id="@item.Id">Ver</a>
							<a asp-action="Eliminar" class="btn btn-outline-danger btn-sm" asp-route-id="@item.Id">Eliminar</a>
						</td>

					</tr>
				}
			}
		}
	</tbody>
</table>