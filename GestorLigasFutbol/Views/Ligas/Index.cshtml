@{
	ViewData["Title"] = "Ligas de Futbol";
}

<div class="container-fluid">
	<h2>Registros de Ligas de Futbol</h2>
	<a type="button" asp-controller="Ligas" asp-action="Registrar" class="btn btn btn-outline-primary "> Agregar nuevo registro</a>
</div>
<table class="table">
	<thead>
		<tr>
			<th>Id Ligas</th>
			<th>Nombre</th>
			<th>Descripcion</th>
			<th>Correo Electronico</th>
			<th>Telefono</th>
			<th>Opciones</th>
			
		</tr>
	</thead>
	<tbody>
		@*programando recorrido de la lista *@
		@{
			if (ViewBag.Ligas != null)
			{
				foreach (var item in ViewBag.Ligas)
				{
					//generando las filas por cada registro
					<tr>
						<td>@item.Id</td>
						<td>@item.Nombre</td>
						<td>@item.Descripcion</td>
						<td>@item.CorreoE</td>
						<td>@item.Telefono</td>
						<td>
							<a asp-action="Editar" class="btn btn-outline-warning btn-sm" asp-route-id="@item.Id">Editar</a>
							<a asp-action="Ver" class="btn btn-outline-primary btn-sm" asp-route-id="@item.Id">Ver</a>
							<a asp-action="Eliminar" class="btn btn-outline-danger btn-sm" asp-route-id="@item.Id">Eliminar</a>
						</td>

					</tr>
				}
			}
		}
	</tbody>
</table>


