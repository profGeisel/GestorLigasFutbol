@model List<Entrenadores>
@{
	ViewData["Title"] = "Entrenadores";
}

<div class="container-fluid">
	<h2>Registros de Entrenadores</h2>
	<a type="button" asp-controller="Entrenadores" asp-action="Insertar" class="btn btn btn-outline-primary "> Agregar nuevo registro</a>
</div>
@if (Model.Count == 0)
{
	<p>No hay usuarios registrados</p>
}
else
{
<table class="table">
	<thead>
		<tr>
			<th>Id</th>
			<th>Nombre</th>
			<th>Apellido P</th>
			<th>Apellido M</th>
			<th>Foto</th>
			<th>Fecha Nacimiento</th>
			<th>Correo</th>
			<th>Cedula</th>
			<th>Equipo</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var item in Model)
		{
					//generando las filas por cada registro
					<tr>
						<td>@Html.DisplayFor(modelsItem=> item.Id)</td>
					<td>@Html.DisplayFor(modelsItem => item.Nombre)</td>
					<td>@Html.DisplayFor(modelsItem => item.ApellidoP)</td>
					<td>@Html.DisplayFor(modelsItem => item.ApellidoM)</td>
					<td>@Html.DisplayFor(modelsItem => item.FechaNacimiento)</td>
					<td>@Html.DisplayFor(modelsItem => item.CorreoE)</td>
					<td>@Html.DisplayFor(modelsItem => item.Cedula)</td>
					<td>@Html.DisplayFor(modelsItem => item.IdEquipo)</td>
						<td>
							<a asp-action="Actualizar" class="btn btn-outline-warning btn-sm" asp-route-id="@item.Id">Editar</a>
							<a asp-action="Ver" class="btn btn-outline-primary btn-sm" asp-route-id="@item.Id">Ver</a>
							<a asp-action="Eliminar" class="btn btn-outline-danger btn-sm" asp-route-id="@item.Id">Eliminar</a>
						</td>

					</tr>
				}
			}
		}
	</tbody>
</table>

}