
<link href="//netdna.bootstrapcdn.com/bootstrap/3.1.0/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">
<script src="//netdna.bootstrapcdn.com/bootstrap/3.1.0/js/bootstrap.min.js"></script>
<script src="//code.jquery.com/jquery-1.11.1.min.js"></script>
@model Entrenadores //referenccia al modelo Entrenadores
@{
	ViewData["Title"] = "Registro de Entrenadores"; //titulo de la pagina
}

<div class="container">
	<div id="registroUs" style="margin-top:50px; margin-bottom:50px;" class=" mainbox col-md-6 col-md-offset-3 col-sm-8 col-sm-offset-2">
		<div class="panel panel-info">
			<h2 class="text-center">Actualizar Entrenadores</h2>
			<div style="padding-top:30px" class="panel-body">
				<form asp-action="Actualizar" method="post" class="form-floating">
					<div class="form-group">
						<label asp-for="Id"></label>
						<input class="form-control" asp-for="Id" readonly/>
					</div>
					<div class="form-group">
						<label asp-for="Nombre"></label>
						<input class="form-control" asp-for=Nombre />
						<span asp-validation-for="Nombre" class="text-danger"></span>
					</div>
					<div class="form-group">
						<label asp-for="ApellidoP"></label>
						<input class="form-control" asp-for=ApellidoP />
						<span asp-validation-for="ApellidoP" class="text-danger"></span>
					</div>
					<div class="form-group">
						<label asp-for="ApellidoM"></label>
						<input class="form-control" asp-for=ApellidoM />
						<span asp-validation-for="ApellidoM" class="text-danger"></span>
					</div>
					<div class="form-group">
						<label asp-for="FechaNacimiento"></label>
						<input class="form-control" asp-for=FechaNacimiento />
						<span asp-validation-for="FechaNacimiento" class="text-danger"></span>
					</div>
					<div class="form-group">
						<label asp-for="CorreoE"></label>
						<input class="form-control" asp-for=CorreoE />
						<span asp-validation-for="CorreoE" class="text-danger"></span>
					</div>
					<div class="form-group">
						<label asp-for="Cedula"></label>
						<input class="form-control" asp-for=Cedula />
						<span asp-validation-for="Cedula" class="text-danger"></span>
					</div>
					<div class="form-group">
						<label asp-for="IdEquipo"></label>
						<input class="form-control" asp-for=IdEquipo />
						<span asp-validation-for="IdEquipo" class="text-danger"></span>
					</div>
					<br />
					<div class="text-center col-sm-12 controls panel-body">
						<button type="submit" value="Actualizar" class="btn btn-sm btn-warning">Actualizar</button>
						<a asp-action="Index" class="btn btn-sm btn-secondary">Regresar a la lista</a>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}